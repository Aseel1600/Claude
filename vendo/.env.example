# Application
NEXT_PUBLIC_APP_NAME=Vendo
NEXT_PUBLIC_APP_TAGLINE=Everything your business needs.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vendo_dev
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/vendo_dev_shadow

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (Optional - for Phase 1.5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment Gateways
OZOW_API_KEY=
OZOW_API_URL=https://api.ozow.com
OZOW_WEBHOOK_SECRET=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=

# Email Provider
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@vendo.africa

# SMS Provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Logging
LOG_LEVEL=info

# Development
NODE_ENV=development
VERCEL_ENV=development

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_PAYSTACK=true
ENABLE_OZOW=true
ENABLE_PAYMENT_LINKS=false
ENABLE_ANALYTICS=true
